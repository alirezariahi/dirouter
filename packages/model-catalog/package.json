{
  "name": "@dirouter/model-catalog",
  "version": "0.0.0",
  "private": true,
  "description": "کاتالوگ نسخه‌دار قیمت و قابلیت مدل‌ها",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --incremental --tsBuildInfoFile dist/.tsbuildinfo",
    "dev": "tsc -p tsconfig.build.json --incremental --tsBuildInfoFile dist/.tsbuildinfo --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --testTimeout=30000",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@dirouter/eslint-config": "workspace:*",
    "@dirouter/tsconfig": "workspace:*",
    "js-tiktoken": "^1.0.21"
  },
  "dependencies": {
    "@dirouter/contracts": "workspace:*",
    "@dirouter/shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "js-tiktoken": "^1.0.21"
  },
  "peerDependenciesMeta": {
    "js-tiktoken": {
      "optional": true
    }
  }
}
