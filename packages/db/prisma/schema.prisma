// Database schema of the control plane (PostgreSQL 17).
// Rules:
// - All foreign keys have indexes.
// - Manageable entities have soft-delete (deleted_at); owned dependents cascade.
// - Money is Decimal(18,8), never float.
// - request_log and the rollup tables are partitioned/managed in raw SQL migrations.

generator client {
  provider   = "prisma-client-js"
  output     = "../generated/client"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Tenancy & identity ─────────────

model Organization {
  id        String    @id
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// Base roles that must complete MFA before login (card 14.1).
  mfaRequiredRoles String[] @default([]) @map("mfa_required_roles")
  /// When SSO is enforced, password login is disabled for this organization (card 14.2).
  passwordLoginDisabled Boolean @default(false) @map("password_login_disabled")
  /// Four-eyes principle (card 22.2): sensitive changes wait for a second person's approval.
  changeApprovalRequired Boolean @default(false) @map("change_approval_required")
  /// The operator's own organization (created by setup). Its OWNER/ADMIN run billing for every
  /// customer organization: wallets, gift codes, pricing and invoices (sprint 3).
  isPlatform Boolean @default(false) @map("is_platform")
  /// Prepaid organizations pay from their wallet: the gateway reserves credit before each request
  /// and the worker debits the real charge afterwards (card 19.1).
  prepaid Boolean @default(false)
  /// `drop_params` (card 31.4): drop a parameter the target model cannot take (true) or answer
  /// the request with a 400 that names it (false). A request can override it.
  dropParams Boolean @default(true) @map("drop_params")

  memberships  Membership[]
  invitations  Invitation[]
  teams        Team[]
  projects     Project[]
  apiKeys      ApiKey[]
  providers    Provider[]
  models       Model[]
  aliases      ModelAlias[]
  combos       Combo[]
  budgets      Budget[]
  rateLimits   RateLimitPolicy[]
  usageLedger  UsageLedger[]
  auditLogs    AuditLog[]
  ssoConnections SsoConnection[]
  customRoles  CustomRole[]
  guardrails   GuardrailPolicy[]
  channels     NotificationChannel[]
  alertRules   AlertRule[]
  alertEvents  AlertEvent[]
  wallet       Wallet?
  payments     Payment[]
  redemptions  GiftCodeRedemption[]
  /// Customer group whose price multiplier applies to this organization (card 19.4).
  customerGroupId String?       @map("customer_group_id")
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id], onDelete: SetNull)
  subscription    Subscription?
  invoices        Invoice[]
  billingProfile  BillingProfile?
  mcpServers      McpServer[]
  agentProfiles   AgentProfile[]

  @@index([customerGroupId])
  scimTokens       ScimToken[]
  scimUsers        ScimUser[]
  scimGroups       ScimGroup[]
  changeRequests   ChangeRequest[]
  serviceAccounts  ServiceAccount[]
  managementTokens ManagementToken[]
  routingRules     RoutingRule[]
  trafficSplits    TrafficSplit[]
  shadowPolicies   ShadowPolicy[]
  autoPolicies     AutoRoutingPolicy[]
  @@map("organizations")
}

model User {
  id           String    @id
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// Null until the address is proven (card 23.4): portal password sign-ups and users who accepted an
  /// invitation that was not delivered by email start unverified; every other way an account is
  /// created (setup, SSO, SCIM, seed) counts as verified.
  emailVerifiedAt DateTime? @default(now()) @map("email_verified_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// The non-human identity behind a service account (card 23.6); it can never sign in.
  isServiceAccount Boolean @default(false) @map("is_service_account")

  memberships    Membership[]
  refreshTokens  RefreshToken[]
  serviceAccount ServiceAccount?
  mfa           UserMfa?
  webauthn      WebAuthnCredential[]
  invitations   Invitation[]   @relation("InvitedBy")
  apiKeys       ApiKey[]       @relation("CreatedBy")
  auditLogs     AuditLog[]
  emailVerifications EmailVerification[]

  @@map("users")
}

/// One-time email verification link of a portal sign-up (card 23.4); only the token's hash is stored.
model EmailVerification {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Membership {
  id             String   @id
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           Role
  /// Optional custom role (card 14.3); its permissions are added to the base role.
  customRoleId   String?  @map("custom_role_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole   CustomRole?  @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([customRoleId])
  @@index([organizationId])
  @@map("memberships")
}

model Invitation {
  id             String    @id
  organizationId String    @map("organization_id")
  email          String
  role           Role
  tokenHash      String    @unique @map("token_hash")
  invitedById    String    @map("invited_by_id")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// When the link was delivered by email to `email`; only then does accepting it prove the address
  /// (the inviter always gets the link back too, so an undelivered invitation proves nothing).
  emailSentAt    DateTime? @map("email_sent_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invitedById])
  @@map("invitations")
}

/// Rotating refresh tokens; each chain has a familyId. Reusing an already-consumed token
/// invalidates the whole family (theft detection).
model RefreshToken {
  id         String    @id
  userId     String    @map("user_id")
  familyId   String    @map("family_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Team {
  id             String    @id
  organizationId String    @map("organization_id")
  name           String
  slug           String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@unique([organizationId, slug])
  @@map("teams")
}

model Project {
  id             String    @id
  organizationId String    @map("organization_id")
  teamId         String?   @map("team_id")
  name           String
  slug           String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  apiKeys      ApiKey[]

  @@unique([organizationId, slug])
  @@index([teamId])
  @@map("projects")
}

// ───────────── Virtual keys ─────────────

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

model ApiKey {
  id             String       @id
  organizationId String       @map("organization_id")
  projectId      String       @map("project_id")
  name           String
  /// Displayable part of the key (`dr-<prefix>`) for lookup in the UI.
  prefix         String       @unique
  /// HMAC-SHA256 of the full key with the server pepper; the raw key is not stored.
  hash           String       @unique
  status         ApiKeyStatus @default(ACTIVE)
  allowedModels  String[]     @default([]) @map("allowed_models")
  /// MCP tools the key may use (card 20.1): `server__tool`, `server__*` or `*`; empty = all.
  mcpTools       String[]     @default([]) @map("mcp_tools")
  /// Native pass-through (card 30.7): provider slugs or `*` the key may call; empty = off.
  passthroughProviders String[] @default([]) @map("passthrough_providers")
  /// DiRouter's own MCP server (card 20.2): none | read | write. Only owners and admins grant it.
  mcpAdmin       String       @default("none") @map("mcp_admin")
  /// Gateway repairs for this key (card 31.1): `json` and/or `tools`; empty = none.
  repair         String[]     @default([])
  ipAllowlist    String[]     @default([]) @map("ip_allowlist")
  rpm            Int?
  tpm            Int?
  /// Input and output tokens per minute apart (card 33.3).
  inputTpm       Int?         @map("input_tpm")
  outputTpm      Int?         @map("output_tpm")
  maxConcurrency Int?         @map("max_concurrency")
  /// Limits on one model (card 33.3): [{ model, rpm?, tpm?, inputTpm?, outputTpm?, maxConcurrency? }];
  /// their budgets are `budgets` rows with scope API_KEY_MODEL and scope id `<key id>|<model>`.
  modelLimits    Json         @default("[]") @map("model_limits")
  expiresAt      DateTime?    @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(3)
  /// The key that replaced this key during rotation.
  rotatedToId    String?      @unique @map("rotated_to_id")
  lastUsedAt     DateTime?    @map("last_used_at") @db.Timestamptz(3)
  createdById    String?      @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rotatedTo    ApiKey?      @relation("Rotation", fields: [rotatedToId], references: [id], onDelete: SetNull)
  rotatedFrom  ApiKey?      @relation("Rotation")

  @@index([organizationId])
  @@index([projectId])
  @@index([createdById])
  @@map("api_keys")
}

// ───────────── Providers & models ─────────────

enum ProviderType {
  OPENAI         @map("openai")
  AZURE_OPENAI   @map("azure-openai")
  OPENAI_COMPATIBLE @map("openai-compatible")
  ANTHROPIC      @map("anthropic")
  GEMINI         @map("gemini")
  BEDROCK        @map("bedrock")
  VERTEX         @map("vertex")
  COHERE         @map("cohere")
  MISTRAL        @map("mistral")
  VOYAGE         @map("voyage")
  JINA           @map("jina")
  ELEVENLABS     @map("elevenlabs")
  DEEPGRAM       @map("deepgram")
  FAL            @map("fal")
  PLUGIN         @map("plugin")
  MOCK           @map("mock")
}

model Provider {
  id             String       @id
  organizationId String       @map("organization_id")
  slug           String
  name           String
  type           ProviderType
  baseUrl        String       @map("base_url")
  enabled        Boolean      @default(true)
  proxyUrl       String?      @map("proxy_url")
  /// { connectMs, firstByteMs, idleMs, totalMs }
  timeouts       Json?
  /// Settings specific to the type (e.g. apiVersion in Azure).
  options        Json         @default("{}")
  maxConcurrency Int?         @map("max_concurrency")
  /// Region, country, zero data retention and training use (card 32.5): { region, country, zdr, trainsOnData }
  dataPolicy     Json?        @map("data_policy")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credentials  Credential[]
  models       Model[]

  @@unique([organizationId, slug])
  @@map("providers")
}

enum CredentialStatus {
  ACTIVE
  DISABLED
}

model Credential {
  id            String           @id
  providerId    String           @map("provider_id")
  name          String
  /// AES-256-GCM with AAD = id; format v<keyVersion>.<base64url>.
  secretEnc     String           @map("secret_enc")
  keyVersion    Int              @map("key_version")
  /// Last four characters, for masked display.
  last4         String
  weight        Int              @default(1)
  status        CredentialStatus @default(ACTIVE)
  cooldownUntil DateTime?        @map("cooldown_until") @db.Timestamptz(3)
  headers       Json             @default("{}")
  /// Outbound proxy for this credential (takes precedence over the provider's proxy_url; card 4.10).
  proxyUrl      String?          @map("proxy_url")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  balance  CredentialBalance?

  @@index([providerId])
  @@map("credentials")
}

/// Latest upstream account balance of a credential (card 32.9); `amount` is in `currency`.
model CredentialBalance {
  credentialId String     @id @map("credential_id")
  providerId   String     @map("provider_id")
  /// Balance API: openrouter | deepseek | moonshot | siliconflow.
  kind         String
  ok           Boolean
  amount       Decimal?   @db.Decimal(20, 8)
  currency     String?
  error        String?
  checkedAt    DateTime   @map("checked_at") @db.Timestamptz(3)

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("credential_balances")
}

model Model {
  id               String    @id
  organizationId   String    @map("organization_id")
  providerId       String    @map("provider_id")
  /// Public name, e.g. openai/gpt-4.1
  slug             String
  upstreamModel    String    @map("upstream_model")
  displayName      String?   @map("display_name")
  enabled          Boolean   @default(true)
  contextWindow    Int?      @map("context_window")
  maxOutputTokens  Int?      @map("max_output_tokens")
  /// Dollars per million tokens
  inputPrice       Decimal   @map("input_price") @db.Decimal(18, 8)
  outputPrice      Decimal   @map("output_price") @db.Decimal(18, 8)
  cacheReadPrice   Decimal?  @map("cache_read_price") @db.Decimal(18, 8)
  cacheWritePrice  Decimal?  @map("cache_write_price") @db.Decimal(18, 8)
  reasoningPrice   Decimal?  @map("reasoning_price") @db.Decimal(18, 8)
  /// Media prices (card 21.1): per image, per million characters of speech, per second of audio.
  imagePrice       Decimal?  @map("image_price") @db.Decimal(18, 8)
  charPrice        Decimal?  @map("char_price") @db.Decimal(18, 8)
  secondPrice      Decimal?  @map("second_price") @db.Decimal(18, 8)
  /// Fixed cost per request (card 30.6), e.g. per generated video.
  requestPrice     Decimal?  @map("request_price") @db.Decimal(18, 8)
  /// Rerank price per search unit (card 30.2).
  searchPrice      Decimal?  @map("search_price") @db.Decimal(18, 8)
  /// Realtime audio tokens, dollars per million (card 30.5); unset means the text rates.
  audioInputPrice  Decimal?  @map("audio_input_price") @db.Decimal(18, 8)
  audioOutputPrice Decimal?  @map("audio_output_price") @db.Decimal(18, 8)
  /// { streaming, tools, vision, reasoning, jsonMode }
  capabilities     Json      @default("{}")
  /// Catalog entry key (packages/model-catalog), if it came from the catalog.
  catalogKey       String?   @map("catalog_key")
  /// Platform model offered to customer organizations (card 19.4).
  isPublic         Boolean   @default(false) @map("is_public")
  /// Sale price = cost × saleMultiplier × the customer group's multiplier (card 19.4).
  saleMultiplier   Decimal   @default(1) @map("sale_multiplier") @db.Decimal(14, 8)
  /// Fixed sale price per request (images, video); replaces the token-based price when set.
  salePerRequestUsd Decimal? @map("sale_per_request_usd") @db.Decimal(18, 8)
  /// Share of the normal sale price charged for an answer served from DiRouter's cache.
  saleCacheMultiplier Decimal @default(0) @map("sale_cache_multiplier") @db.Decimal(14, 8)
  /// Context-length price tiers, `[{ aboveInputTokens, inputPerMTok, outputPerMTok, … }]` (card 27.5).
  pricingTiers     Json?     @map("pricing_tiers")
  /// Service tier prices (card 31.5): { flex?: {inputPerMTok, outputPerMTok, cacheReadPerMTok?}, priority?: … }
  serviceTierPrices Json?    @map("service_tier_prices")
  /// Batch API discount as a fraction (0.5 = half price).
  batchDiscount    Decimal?  @map("batch_discount") @db.Decimal(7, 6)
  /// Provider's announced retirement date.
  deprecationDate  DateTime? @map("deprecation_date") @db.Date
  /// The organization set this catalog model's price by hand: catalog syncs leave it alone.
  priceOverride    Boolean   @default(false) @map("price_override")
  /// Request shaping (epic 31), `RequestPolicy` in @dirouter/contracts: { autoCache, … }.
  requestPolicy    Json?     @map("request_policy")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider     Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  aliases      ModelAlias[]
  comboTargets ComboTarget[]

  @@unique([organizationId, slug])
  @@index([providerId])
  @@map("models")
}

model ModelAlias {
  id             String   @id
  organizationId String   @map("organization_id")
  slug           String
  modelId        String?  @map("model_id")
  comboId        String?  @map("combo_id")
  /// Request shaping for this alias over its model's own (epic 31), `RequestPolicy`.
  requestPolicy  Json?    @map("request_policy")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  model        Model?       @relation(fields: [modelId], references: [id], onDelete: Cascade)
  combo        Combo?       @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([modelId])
  @@index([comboId])
  @@map("model_aliases")
}

enum ComboStrategy {
  PRIORITY    @map("priority")
  WEIGHTED    @map("weighted")
  ROUND_ROBIN @map("round-robin")
  LATENCY     @map("latency")
  COST        @map("cost")
  LEAST_USED  @map("least-used")
  HEADROOM    @map("headroom")
}

model Combo {
  id               String        @id
  organizationId   String        @map("organization_id")
  slug             String
  strategy         ComboStrategy @default(PRIORITY)
  /// Error classes that trigger fallback (UpstreamErrorClass).
  fallbackOn       String[]      @default([]) @map("fallback_on")
  retryMaxAttempts Int           @default(2) @map("retry_max_attempts")
  timeouts         Json?
  /// Keep a session on the same target while it is healthy (card 12.4).
  sticky           Boolean       @default(false)
  /// { enabled, afterMs, maxParallel } (card 12.2).
  hedging          Json?
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targets      ComboTarget[]
  aliases      ModelAlias[]

  /// Platform combo offered to customer organizations (card 19.4).
  isPublic Boolean @default(false) @map("is_public")

  @@unique([organizationId, slug])
  @@map("combos")
}

model ComboTarget {
  id      String @id
  comboId String @map("combo_id")
  modelId String @map("model_id")
  order   Int
  weight  Int    @default(1)

  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([comboId, modelId])
  @@index([modelId])
  @@map("combo_targets")
}

// ───────────── Limits & budgets ─────────────

enum LimitScope {
  API_KEY      @map("api_key")
  PROJECT      @map("project")
  TEAM         @map("team")
  /// Card 33.1: the whole organization, a member's keys, a model or a provider.
  ORGANIZATION @map("organization")
  USER         @map("user")
  MODEL        @map("model")
  PROVIDER     @map("provider")
  /// Card 33.2: one end user of the organization's own product; scope id `*` holds the defaults.
  END_USER     @map("end_user")
  /// Card 33.3: one model of one key; scope id `<key id>|<model>`.
  API_KEY_MODEL @map("api_key_model")
}

enum BudgetPeriod {
  DAILY   @map("daily")
  /// ISO week, Monday 00:00 UTC (card 33.1).
  WEEKLY  @map("weekly")
  MONTHLY @map("monthly")
  YEARLY  @map("yearly")
}

model Budget {
  id              String       @id
  organizationId  String       @map("organization_id")
  scope           LimitScope
  /// Key, project, team, organization, user, model or provider ID
  scopeId         String       @map("scope_id")
  period          BudgetPeriod
  limitUsd        Decimal?     @map("limit_usd") @db.Decimal(18, 8)
  limitTokens     BigInt?      @map("limit_tokens")
  alertThresholds Int[]        @default([50, 80, 100]) @map("alert_thresholds")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Scope ids are unique per organization only (card 33.1), so the organization is part of the key.
  @@unique([organizationId, scope, scopeId, period])
  @@index([organizationId])
  @@map("budgets")
}

/// Organization-, team-, project-, member-, model- and provider-level limits; key-level limits are on the ApiKey itself.
model RateLimitPolicy {
  id             String     @id
  organizationId String     @map("organization_id")
  scope          LimitScope
  scopeId        String     @map("scope_id")
  rpm            Int?
  tpm            Int?
  inputTpm       Int?       @map("input_tpm")
  outputTpm      Int?       @map("output_tpm")
  maxConcurrency Int?       @map("max_concurrency")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, scopeId])
  @@index([organizationId])
  @@map("rate_limit_policies")
}

// ───────────── Usage & logs ─────────────

/// Monthly partitioned table (raw SQL migration). The primary key includes the partition column.
/// Reference IDs intentionally have no FK: the log must remain after a key/project is deleted.
model RequestLog {
  id               String   @map("id")
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)
  organizationId   String   @map("organization_id")
  teamId           String?  @map("team_id")
  projectId        String   @map("project_id")
  apiKeyId         String   @map("api_key_id")
  endUser          String?  @map("end_user")
  inboundApi       String   @map("inbound_api")
  requestedModel   String   @map("requested_model")
  modelId          String?  @map("model_id")
  providerId       String?  @map("provider_id")
  credentialId     String?  @map("credential_id")
  stream           Boolean
  status           String
  httpStatus       Int      @map("http_status")
  errorCode        String?  @map("error_code")
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int      @default(0) @map("cache_write_tokens")
  reasoningTokens  Int      @default(0) @map("reasoning_tokens")
  costUsd          Decimal  @map("cost_usd") @db.Decimal(18, 8)
  /// What the customer was charged (sale price, card 19.4); equals cost_usd without pricing rules.
  chargeUsd        Decimal  @default(0) @map("charge_usd") @db.Decimal(18, 8)
  usageEstimated   Boolean  @default(false) @map("usage_estimated")
  latencyMs        Int      @map("latency_ms")
  ttftMs           Int?     @map("ttft_ms")
  attempts         Json     @default("[]")
  configVersion    Int      @map("config_version")
  gatewayInstance  String   @map("gateway_instance")
  cacheHit         Boolean  @default(false) @map("cache_hit")
  cacheKind        String?  @map("cache_kind")
  savedInputTokens Int      @default(0) @map("saved_input_tokens")
  hedgeAttempts    Int      @default(0) @map("hedge_attempts")
  /// How an `auto*` alias was resolved (card 20.4): target, task type, source and reasons.
  routing          Json?
  /// Images, characters or audio seconds of a media request (card 21.1).
  media            Json?
  /// What the organization's routing policies did (sprint 5): matched rules, split branch.
  policy           Json?
  /// How the route was planned (cards 32.5 and 32.7): data policy, removed targets and more.
  routeDecision    Json?    @map("route_decision")
  /// Service tier the request was priced at (card 31.5): flex or priority.
  serviceTier      String?  @map("service_tier")

  @@id([id, createdAt])
  @@index([projectId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([organizationId, createdAt])
  @@index([status])
  @@map("request_log")
}

/// Financial ledger; one row per request (idempotent by request_id).
model UsageLedger {
  id             String   @id
  requestId      String   @unique @map("request_id")
  organizationId String   @map("organization_id")
  teamId         String?  @map("team_id")
  projectId      String   @map("project_id")
  apiKeyId       String   @map("api_key_id")
  /// Model and provider that served the request, for model and provider budgets (card 33.1).
  modelId        String?  @map("model_id")
  providerId     String?  @map("provider_id")
  /// End user named by the request (card 33.2), for end-user budgets.
  endUser        String?  @map("end_user")
  /// The name the client asked for (card 33.3), for a key's budgets on an alias or combo.
  requestedModel String?  @map("requested_model")
  costUsd        Decimal  @map("cost_usd") @db.Decimal(18, 8)
  tokens         Int
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([apiKeyId, occurredAt])
  @@index([teamId, occurredAt])
  @@map("usage_ledger")
}

/// Hourly rollup (upserted by the worker).
model UsageHourly {
  bucket           DateTime @db.Timestamptz(3)
  organizationId   String   @map("organization_id")
  projectId        String   @map("project_id")
  apiKeyId         String   @map("api_key_id")
  modelSlug        String   @map("model_slug")
  providerId       String   @map("provider_id")
  teamId           String?  @map("team_id")
  requests         Int      @default(0)
  errors           Int      @default(0)
  inputTokens      BigInt   @default(0) @map("input_tokens")
  outputTokens     BigInt   @default(0) @map("output_tokens")
  cacheReadTokens  BigInt   @default(0) @map("cache_read_tokens")
  costUsd          Decimal  @default(0) @map("cost_usd") @db.Decimal(18, 8)
  chargeUsd        Decimal  @default(0) @map("charge_usd") @db.Decimal(18, 8)
  latencyMsSum     BigInt   @default(0) @map("latency_ms_sum")
  ttftMsSum        BigInt   @default(0) @map("ttft_ms_sum")
  ttftCount        Int      @default(0) @map("ttft_count")
  /// Latency histogram (fixed buckets) for approximate p50/p95/p99.
  latencyHist      Int[]    @default([]) @map("latency_hist")

  @@id([bucket, organizationId, projectId, apiKeyId, modelSlug, providerId])
  @@index([organizationId, bucket])
  @@map("usage_hourly")
}

/// Daily rollup (upserted by the worker).
model UsageDaily {
  bucket           DateTime @db.Date
  organizationId   String   @map("organization_id")
  projectId        String   @map("project_id")
  apiKeyId         String   @map("api_key_id")
  modelSlug        String   @map("model_slug")
  providerId       String   @map("provider_id")
  teamId           String?  @map("team_id")
  requests         Int      @default(0)
  errors           Int      @default(0)
  inputTokens      BigInt   @default(0) @map("input_tokens")
  outputTokens     BigInt   @default(0) @map("output_tokens")
  cacheReadTokens  BigInt   @default(0) @map("cache_read_tokens")
  costUsd          Decimal  @default(0) @map("cost_usd") @db.Decimal(18, 8)
  chargeUsd        Decimal  @default(0) @map("charge_usd") @db.Decimal(18, 8)
  latencyMsSum     BigInt   @default(0) @map("latency_ms_sum")
  ttftMsSum        BigInt   @default(0) @map("ttft_ms_sum")
  ttftCount        Int      @default(0) @map("ttft_count")
  latencyHist      Int[]    @default([]) @map("latency_hist")

  @@id([bucket, organizationId, projectId, apiKeyId, modelSlug, providerId])
  @@index([organizationId, bucket])
  @@map("usage_daily")
}

/// An end user of an organization's own product (card 33.2): created when a request first names
/// it (`user` field or `x-dirouter-end-user` header), or by the API to block it in advance. No FK:
/// like the usage tables, it outlives what it refers to.
model EndUser {
  id             String   @id
  organizationId String   @map("organization_id")
  /// The id the organization's product sends.
  externalId     String   @map("external_id")
  blocked        Boolean  @default(false)
  firstSeenAt    DateTime? @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, externalId])
  @@index([organizationId, lastSeenAt])
  @@map("end_users")
}

/// Hourly usage per attribution dimension (card 33.2 end users; card 33.4 tags and cost centers),
/// with at most 1000 values per organization, dimension and hour (the rest is `__other__`).
model UsageDimensionHourly {
  bucket         DateTime @db.Timestamptz(3)
  organizationId String   @map("organization_id")
  dimension      String
  value          String
  projectId      String   @map("project_id")
  apiKeyId       String   @map("api_key_id")
  modelSlug      String   @map("model_slug")
  providerId     String   @map("provider_id")
  requests       Int      @default(0)
  errors         Int      @default(0)
  inputTokens    BigInt   @default(0) @map("input_tokens")
  outputTokens   BigInt   @default(0) @map("output_tokens")
  costUsd        Decimal  @default(0) @map("cost_usd") @db.Decimal(18, 8)
  chargeUsd      Decimal  @default(0) @map("charge_usd") @db.Decimal(18, 8)

  @@id([bucket, organizationId, dimension, value, projectId, apiKeyId, modelSlug, providerId])
  @@index([organizationId, dimension, bucket])
  @@map("usage_dimension_hourly")
}

/// Daily usage per attribution dimension, from the hourly table.
model UsageDimensionDaily {
  bucket         DateTime @db.Date
  organizationId String   @map("organization_id")
  dimension      String
  value          String
  projectId      String   @map("project_id")
  apiKeyId       String   @map("api_key_id")
  modelSlug      String   @map("model_slug")
  providerId     String   @map("provider_id")
  requests       Int      @default(0)
  errors         Int      @default(0)
  inputTokens    BigInt   @default(0) @map("input_tokens")
  outputTokens   BigInt   @default(0) @map("output_tokens")
  costUsd        Decimal  @default(0) @map("cost_usd") @db.Decimal(18, 8)
  chargeUsd      Decimal  @default(0) @map("charge_usd") @db.Decimal(18, 8)

  @@id([bucket, organizationId, dimension, value, projectId, apiKeyId, modelSlug, providerId])
  @@index([organizationId, dimension, bucket])
  @@map("usage_dimension_daily")
}

// ───────────── Config & audit ─────────────

/// Each snapshot publish is one row with an incrementing number.

// ───────────── Sprint 2: security, guardrails & operations ─────────────

/// TOTP second factor (card 14.1); the secret is AES-256-GCM encrypted like provider keys.
model UserMfa {
  id               String   @id
  userId           String   @unique @map("user_id")
  secretEnc        String   @map("secret_enc")
  keyVersion       Int      @default(1) @map("key_version")
  enabled          Boolean  @default(false)
  backupCodeHashes String[] @default([]) @map("backup_code_hashes")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

/// Passkey / WebAuthn credential (card 14.1).
model WebAuthnCredential {
  id           String    @id
  userId       String    @map("user_id")
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  name         String    @default("passkey")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

/// OIDC SSO connection per organization (card 14.2).
model SsoConnection {
  id              String   @id
  organizationId  String   @map("organization_id")
  name            String
  issuer          String
  clientId        String   @map("client_id")
  clientSecretEnc String   @map("client_secret_enc")
  keyVersion      Int      @default(1) @map("key_version")
  enabled         Boolean  @default(true)
  defaultRole     Role     @default(MEMBER) @map("default_role")
  allowedDomains  String[] @default([]) @map("allowed_domains")
  /// IdP group name → application role (OWNER/ADMIN/MEMBER/VIEWER).
  groupRoleMap    Json     @default("{}") @map("group_role_map")
  /// `oidc` or `saml` (card 22.1). For SAML, `issuer` is the IdP entity ID, `clientId` the SP
  /// entity ID (audience), and the IdP's sign-on URL and signing certificate are below.
  protocol        String   @default("oidc")
  samlSsoUrl      String?  @map("saml_sso_url")
  samlCert        String?  @map("saml_cert")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("sso_connections")
}

enum ChangeRequestStatus {
  PENDING   @map("pending")
  APPLIED   @map("applied")
  FAILED    @map("failed")
  REJECTED  @map("rejected")
  CANCELLED @map("cancelled")
  EXPIRED   @map("expired")
}

/// A sensitive change waiting for a second person's approval (card 22.2).
model ChangeRequest {
  id             String              @id
  organizationId String              @map("organization_id")
  /// What to do, e.g. `provider.delete`; the payload holds its arguments.
  kind           String
  targetId       String?             @map("target_id")
  payload        Json
  summary        String
  status         ChangeRequestStatus @default(PENDING)
  requestedById  String              @map("requested_by_id")
  /// The person behind the request when it was made with a management token (the token's creator);
  /// null for requests made from a dashboard session, where `requestedById` is that person.
  requestedByHumanId String?         @map("requested_by_human_id")
  decidedById    String?             @map("decided_by_id")
  decidedAt      DateTime?           @map("decided_at") @db.Timestamptz(3)
  reason         String?
  /// Why applying failed (status FAILED).
  error          String?
  expiresAt      DateTime            @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@map("change_requests")
}

/// SCIM 2.0 provisioning (card 22.1): bearer tokens the identity provider uses, one org each.
model ScimToken {
  id             String    @id
  organizationId String    @map("organization_id")
  name           String
  /// SHA-256 of the token; the token itself is shown once.
  tokenHash      String    @unique @map("token_hash")
  prefix         String
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("scim_tokens")
}

/// Non-human member of one organization (card 23.6). It is backed by a user row that can never
/// sign in, so its membership carries the role and every audit row and `created_by` reference
/// names it like a person.
model ServiceAccount {
  id             String    @id
  organizationId String    @map("organization_id")
  userId         String    @unique @map("user_id")
  name           String
  description    String?
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens       ManagementToken[]

  @@index([organizationId])
  @@map("service_accounts")
}

/// Management API token of a service account (card 23.6). Only the SHA-256 of the token is kept;
/// the token itself is shown once. Scopes are permissions of the RBAC matrix.
model ManagementToken {
  id               String    @id
  organizationId   String    @map("organization_id")
  serviceAccountId String    @map("service_account_id")
  name             String
  tokenHash        String    @unique @map("token_hash")
  prefix           String
  scopes           String[]
  /// Addresses or CIDR ranges the token may be used from; empty means anywhere.
  allowedIps       String[]  @default([]) @map("allowed_ips")
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  lastUsedIp       String?   @map("last_used_ip")
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdById      String?   @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceAccount ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([serviceAccountId])
  @@map("management_tokens")
}

/// A user as the identity provider manages it; the membership follows `active`.
model ScimUser {
  id             String   @id
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  userName       String   @map("user_name")
  externalId     String?  @map("external_id")
  active         Boolean  @default(true)
  /// Role of the membership while active; restored when the user is reactivated.
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groups       ScimGroupMember[]

  @@unique([organizationId, userId])
  @@unique([organizationId, userName])
  @@map("scim_users")
}

/// An identity provider group; its name maps to a role through the SSO connection's group map.
model ScimGroup {
  id             String   @id
  organizationId String   @map("organization_id")
  displayName    String   @map("display_name")
  externalId     String?  @map("external_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ScimGroupMember[]

  @@unique([organizationId, displayName])
  @@map("scim_groups")
}

model ScimGroupMember {
  groupId    String @map("group_id")
  scimUserId String @map("scim_user_id")

  group ScimGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  ScimUser  @relation(fields: [scimUserId], references: [id], onDelete: Cascade)

  @@id([groupId, scimUserId])
  @@index([scimUserId])
  @@map("scim_group_members")
}

/// Custom organization role (card 14.3); permissions are a subset of the static matrix.
model CustomRole {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String
  permissions    String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@unique([organizationId, name])
  @@map("custom_roles")
}

/// Guardrail policy evaluated by the gateway (card 15.1).
model GuardrailPolicy {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String
  enabled        Boolean  @default(true)
  stage          String   @default("both")
  type           String
  action         String   @default("block")
  config         Json     @default("{}")
  message        String?
  /// Optional narrowing to one API key or project; null means organization-wide.
  virtualKeyId   String?  @map("virtual_key_id")
  projectId      String?  @map("project_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([virtualKeyId])
  @@index([projectId])
  @@map("guardrail_policies")
}

/// Webhook / Slack / email destination for alerts (card 16.2).
model NotificationChannel {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String
  type           String
  config         Json     @default("{}")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules        AlertRule[]

  @@index([organizationId])
  @@map("notification_channels")
}

/// Alert rule (card 16.2): error rate, budget burn, latency, breaker state.
model AlertRule {
  id             String    @id
  organizationId String    @map("organization_id")
  name           String
  type           String
  threshold      Decimal?  @db.Decimal(18, 8)
  windowMinutes  Int       @default(15) @map("window_minutes")
  /// Minimum minutes between notifications for the same rule/dedup key.
  silenceMinutes Int       @default(60) @map("silence_minutes")
  channelId      String?   @map("channel_id")
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      NotificationChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  events       AlertEvent[]

  @@index([organizationId])
  @@index([channelId])
  @@map("alert_rules")
}

model AlertEvent {
  id             String    @id
  organizationId String    @map("organization_id")
  ruleId         String    @map("rule_id")
  severity       String    @default("warning")
  title          String
  details        Json?
  dedupKey       String?  @map("dedup_key")
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(3)
  deliveryError  String?  @map("delivery_error")
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         AlertRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, dedupKey])
  @@index([organizationId, createdAt])
  @@index([ruleId])
  @@map("alert_events")
}


/// Periodic active health probe result (card 12.3); retained for uptime analytics.
model ProviderHealthSample {
  id           String   @id
  providerId   String   @map("provider_id")
  credentialId String?  @map("credential_id")
  ok           Boolean
  status       Int?
  latencyMs    Int      @map("latency_ms")
  errorClass   String?  @map("error_class")
  checkedAt    DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)

  @@index([providerId, checkedAt])
  @@index([credentialId, checkedAt])
  @@map("provider_health_samples")
}

/// Gateway-wide runtime settings (single row, id = "global"); copied into ConfigSnapshot.settings.
model GatewaySetting {
  id        String   @id @default("global")
  settings  Json     @default("{}")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("gateway_settings")
}

model ConfigVersion {
  version   Int      @id @default(autoincrement())
  checksum  String
  /// Set on rollback/import: checksum of the database-built content when the image was pinned.
  baseChecksum String? @map("base_checksum")
  snapshot  Json
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("config_versions")
}

model AuditLog {
  id             String   @id
  organizationId String   @map("organization_id")
  actorUserId    String?  @map("actor_user_id")
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  diff           Json?
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ───────────── Sprint 3: billing ─────────────

enum WalletKind {
  CUSTOMER @map("customer")
  SYSTEM   @map("system")
}

/// Credit account (card 19.1). A customer wallet belongs to one organization and can never go
/// below zero (CHECK constraint). System wallets are the other side of every posting: `revenue`
/// (usage sold), `funding` (money received), `promo` (gift credit) and `writeoff` (usage that
/// could not be collected); they may go negative.
model Wallet {
  id             String     @id
  kind           WalletKind
  organizationId String?    @unique @map("organization_id")
  /// System wallet code; null for customer wallets.
  code           String?    @unique
  /// Cached sum of this wallet's entries, updated in the same transaction as every posting.
  balanceUsd     Decimal    @default(0) @map("balance_usd") @db.Decimal(18, 8)
  /// Incremented by every posting; Valkey keeps the copy with the highest version.
  version        Int        @default(0)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entries      WalletEntry[]

  @@map("wallets")
}

/// One balanced journal entry: its entries always sum to zero (deferred constraint trigger).
model WalletTransaction {
  id             String   @id
  /// usage | topup | gift | adjustment | refund | plan | invoice
  kind           String
  /// Makes every posting idempotent (`usage:<requestId>`, `payment:<id>`, ...).
  idempotencyKey String   @unique @map("idempotency_key")
  description    String?
  metadata       Json     @default("{}")
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entries WalletEntry[]

  @@index([kind, createdAt])
  @@map("wallet_transactions")
}

/// One leg of a transaction. Positive credits the wallet, negative debits it.
model WalletEntry {
  id            String   @id
  transactionId String   @map("transaction_id")
  walletId      String   @map("wallet_id")
  amountUsd     Decimal  @map("amount_usd") @db.Decimal(18, 8)
  /// Customer wallet balance right after this entry (running balance for statements); null on
  /// system wallets, whose balance is not cached.
  balanceAfter  Decimal? @map("balance_after") @db.Decimal(18, 8)
  /// The wallet's version after this posting: exact statement order on customer wallets (postings
  /// commit in lock order, which created_at, the transaction start time, does not follow).
  sequence      Int?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([walletId, sequence])
  @@index([transactionId])
  @@map("wallet_entries")
}

enum PaymentStatus {
  PENDING   @map("pending")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  EXPIRED   @map("expired")
}

/// Online wallet top-up (card 19.2). The credit is posted to the ledger exactly once, in the same
/// database transaction that moves the payment from PENDING to SUCCEEDED.
model Payment {
  id             String        @id
  organizationId String        @map("organization_id")
  /// zarinpal | stripe
  provider       String
  status         PaymentStatus @default(PENDING)
  /// Credit added to the wallet on success.
  amountUsd      Decimal       @map("amount_usd") @db.Decimal(18, 8)
  /// What the provider charges: ISO currency and integer minor units (rials, cents).
  currency       String
  amountMinor    BigInt        @map("amount_minor")
  /// Units of `currency` per USD used for this payment (frozen at creation).
  exchangeRate   Decimal       @map("exchange_rate") @db.Decimal(24, 8)
  /// Zarinpal authority or Stripe Checkout Session id.
  providerRef    String?       @map("provider_ref")
  /// Zarinpal ref_id or Stripe payment_intent, once paid.
  providerTxId   String?       @map("provider_tx_id")
  returnUrl      String?       @map("return_url")
  failureReason  String?       @map("failure_reason")
  transactionId  String?       @unique @map("transaction_id")
  createdById    String?       @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt    DateTime?     @map("completed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRef])
  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

/// Operator billing settings (single row, id = "global"): exchange rates, top-up limits and the
/// payment providers offered to customers. Edited from the platform organization without a deploy.
model BillingSetting {
  id        String   @id @default("global")
  settings  Json     @default("{}")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("billing_settings")
}

/// A batch of gift or recharge codes (card 19.3). `gift` credit comes from the promo account,
/// `recharge` (codes sold offline) from the funding account.
model GiftCodeBatch {
  id              String    @id
  name            String
  /// gift | recharge
  kind            String
  amountUsd       Decimal   @map("amount_usd") @db.Decimal(18, 8)
  /// How many organizations may redeem each code (1 = single use).
  maxRedemptions  Int       @map("max_redemptions")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  codes GiftCode[]

  @@map("gift_code_batches")
}

/// One code. Only an HMAC of the code is stored; the code itself is shown once, at generation.
model GiftCode {
  id          String   @id
  batchId     String   @map("batch_id")
  codeHash    String   @unique @map("code_hash")
  /// First characters of the code, to recognise it in reports.
  hint        String
  redemptions Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  batch   GiftCodeBatch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  redeems GiftCodeRedemption[]

  @@index([batchId])
  @@map("gift_codes")
}

/// Each organization redeems a given code at most once.
model GiftCodeRedemption {
  id             String   @id
  codeId         String   @map("code_id")
  organizationId String   @map("organization_id")
  transactionId  String   @unique @map("transaction_id")
  redeemedById   String?  @map("redeemed_by_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  code         GiftCode     @relation(fields: [codeId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([codeId, organizationId])
  @@index([organizationId])
  @@map("gift_code_redemptions")
}

/// Customer group (card 19.4): its multiplier scales every sale price for member organizations.
model CustomerGroup {
  id          String   @id
  name        String   @unique
  multiplier  Decimal  @db.Decimal(14, 8)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizations Organization[]

  @@map("customer_groups")
}

/// Monthly subscription plan (card 19.4): a fixed fee per period buys `includedUsd` of usage at
/// sale price; usage beyond it is paid from the wallet.
model Plan {
  id          String   @id
  name        String   @unique
  priceUsd    Decimal  @map("price_usd") @db.Decimal(18, 8)
  includedUsd Decimal  @map("included_usd") @db.Decimal(18, 8)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  ACTIVE    @map("active")
  PAST_DUE  @map("past_due")
  CANCELLED @map("cancelled")
}

/// An organization's plan. The fee for each period is posted to the ledger when the period starts;
/// `usedUsd` counts the allowance consumed in the current period.
model Subscription {
  id                 String             @id
  organizationId     String             @unique @map("organization_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(ACTIVE)
  periodStart        DateTime           @map("period_start") @db.Timestamptz(3)
  periodEnd          DateTime           @map("period_end") @db.Timestamptz(3)
  usedUsd            Decimal            @default(0) @map("used_usd") @db.Decimal(18, 8)
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  usage        SubscriptionUsage[]

  @@index([planId])
  @@index([status, periodEnd])
  @@map("subscriptions")
}

/// Plan allowance used by one request (idempotent by request id, like the wallet debit).
model SubscriptionUsage {
  requestId      String       @id @map("request_id")
  subscriptionId String       @map("subscription_id")
  amountUsd      Decimal      @map("amount_usd") @db.Decimal(18, 8)
  periodStart    DateTime     @map("period_start") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, periodStart])
  @@map("subscription_usage")
}

/// Monthly invoice of one organization (card 19.6). Prepaid organizations are invoiced from their
/// wallet ledger, so every figure can be checked against it; postpaid ones from their usage.
model Invoice {
  id             String   @id
  /// INV-<year>-<sequence>, gap-free per year.
  number         String   @unique
  organizationId String   @map("organization_id")
  /// YYYY-MM (UTC month).
  period         String
  /// prepaid (from the ledger) | postpaid (from usage)
  basis          String
  openingUsd     Decimal  @map("opening_usd") @db.Decimal(18, 8)
  closingUsd     Decimal  @map("closing_usd") @db.Decimal(18, 8)
  /// Totals by transaction kind (topup, gift, adjustment, usage, plan, refund) and the usage
  /// breakdown by model; amounts are decimal strings.
  totals         Json
  lines          Json
  /// Tax fields (card 26.1); null on invoices issued before them. Charges include VAT: the
  /// invoice splits the taxable amount (gross) into net + VAT at this rate.
  vatPercent     Decimal? @map("vat_percent") @db.Decimal(5, 2)
  /// What the customer was charged in the period for services: usage and plan fees.
  grossUsd       Decimal  @default(0) @map("gross_usd") @db.Decimal(18, 8)
  netUsd         Decimal  @default(0) @map("net_usd") @db.Decimal(18, 8)
  vatUsd         Decimal  @default(0) @map("vat_usd") @db.Decimal(18, 8)
  /// Rials per USD from the billing settings when the invoice was issued; null when none was set.
  exchangeRateIrr Decimal? @map("exchange_rate_irr") @db.Decimal(18, 8)
  /// Seller and buyer legal details as they were when the invoice was issued.
  seller         Json?
  buyer          Json?
  /// The ledger transaction that booked this invoice's VAT (and a postpaid sale), if any.
  ledgerTransactionId String? @map("ledger_transaction_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, period])
  @@index([period])
  @@map("invoices")
}

/// Legal details printed on invoices (card 26.1): the buyer's for a customer organization, the
/// seller's for the platform organization.
model BillingProfile {
  organizationId String   @id @map("organization_id")
  /// legal (company: 11-digit national ID) | natural (person: 10-digit national code)
  partyType      String   @default("legal") @map("party_type")
  legalName      String   @map("legal_name")
  nationalId     String?  @map("national_id")
  economicCode   String?  @map("economic_code")
  registrationNumber String? @map("registration_number")
  address        String?
  postalCode     String?  @map("postal_code")
  phone          String?
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("billing_profiles")
}

/// An MCP server the gateway aggregates under /mcp (card 20.1).
model McpServer {
  id              String    @id
  organizationId  String    @map("organization_id")
  name            String
  /// Tool prefix: tools appear as `<slug>__<tool>`.
  slug            String
  /// streamable-http | sse | a2a
  transport       String
  url             String
  /// Encrypted JSON object of headers sent upstream (e.g. Authorization); AAD `mcp:<id>`.
  headersEnc      String?   @map("headers_enc")
  /// Encrypted JSON `McpOAuthConfig` (shared OAuth 2.1 credential, card 28.1); AAD `mcp-oauth:<id>`.
  oauthEnc        String?   @map("oauth_enc")
  enabled         Boolean   @default(true)
  forwardIdentity Boolean   @default(false) @map("forward_identity")
  timeoutMs       Int       @default(60000) @map("timeout_ms")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("mcp_servers")
}

/// One MCP tool call through the gateway (written by the worker from the `mcp-calls` queue).
/// References have no foreign keys: the log outlives deleted keys and servers.
model McpToolCall {
  id              String   @id
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz(3)
  organizationId  String   @map("organization_id")
  projectId       String   @map("project_id")
  apiKeyId        String   @map("api_key_id")
  serverId        String   @map("server_id")
  tool            String
  /// Masked by the gateway before it left: secrets replaced, long values cut.
  arguments       Json
  status          String
  errorMessage    String?  @map("error_message")
  latencyMs       Int      @map("latency_ms")
  gatewayInstance String   @map("gateway_instance")

  @@index([organizationId, occurredAt])
  @@index([apiKeyId, occurredAt])
  @@map("mcp_tool_calls")
}

/// A coding-agent setup (card 20.5): tool, main model and the fast model for background tasks.
model AgentProfile {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String
  /// claude-code | codex | opencode | gemini-cli | aider | env
  tool           String
  mainModel      String   @map("main_model")
  fastModel      String   @map("fast_model")
  options        Json     @default("{}")
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("agent_profiles")
}

// ───────────── Catalog sync (card 27.5) ─────────────

/// Catalog entries synced from external price sources. They overlay the catalog bundled with the
/// release (packages/model-catalog); a key here wins over the bundled entry with the same key.
model CatalogModel {
  key             String    @id
  provider        String
  upstreamModel   String    @map("upstream_model")
  contextWindow   Int?      @map("context_window")
  maxOutputTokens Int?      @map("max_output_tokens")
  /// ModelPricing JSON (decimal strings per million tokens, tiers, batchDiscount).
  pricing         Json
  capabilities    Json      @default("{}")
  deprecationDate DateTime? @map("deprecation_date") @db.Date
  mode            String?
  /// URL of the source that last listed this entry.
  source          String
  /// Set while the sources no longer list the entry; cleared when it comes back.
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([provider, upstreamModel])
  @@map("catalog_models")
}

enum CatalogProposalStatus {
  pending
  approved
  rejected
  superseded
}

/// A price change seen in a source that waits for an admin (manual mode, or a suspiciously large
/// change in automatic mode). Until it is approved, request costs keep the current price.
model CatalogPriceProposal {
  id              String                @id
  catalogKey      String                @map("catalog_key")
  source          String
  /// Price in force when the proposal was made (null for a bundled entry never synced).
  currentPricing  Json?                 @map("current_pricing")
  proposedPricing Json                  @map("proposed_pricing")
  /// Largest old/new ratio of the token rates; null when a rate became or was zero.
  changeFactor    Decimal?              @map("change_factor") @db.Decimal(12, 4)
  /// Why it was not applied automatically: manual_mode | large_change.
  reason          String
  status          CatalogProposalStatus @default(pending)
  decidedById     String?               @map("decided_by_id")
  decidedAt       DateTime?             @map("decided_at") @db.Timestamptz(3)
  /// Organization models repriced when the proposal was approved.
  appliedModels   Int?                  @map("applied_models")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([catalogKey, status])
  @@map("catalog_price_proposals")
}

/// One run of the catalog sync job, for the admin page and alerting.
model CatalogSyncRun {
  id         String    @id
  /// ok | failed | disabled
  status     String
  sources    String[]
  mode       String
  added      Int       @default(0)
  updated    Int       @default(0)
  repriced   Int       @default(0)
  proposed   Int       @default(0)
  removed    Int       @default(0)
  skipped    Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  @@index([startedAt])
  @@map("catalog_sync_runs")
}

/// Admin settings of the catalog sync, `{ enabled, sources, mode, maxChangeFactor }`; absent fields
/// fall back to the worker's CATALOG_SYNC_* environment variables.
model CatalogSyncSetting {
  id        String   @id @default("global")
  settings  Json     @default("{}")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("catalog_sync_settings")
}

// ───────────── Request bodies (card 24.1) ─────────────

/// Body capture level of an organization, project or virtual key: none | metadata | full. No row
/// means "inherit": a key falls back to its project, then its organization, then the instance
/// default. No foreign key: the scope id points at one of three tables.
model BodyCaptureSetting {
  organizationId String   @map("organization_id")
  /// organization | project | key
  scope          String
  scopeId        String   @map("scope_id")
  level          String
  updatedById    String?  @map("updated_by_id")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([organizationId, scope, scopeId])
  @@map("body_capture_settings")
}

/// Stored request and answer bodies, written by the worker from the `request-bodies` queue.
/// Daily partitions on created_at with their own retention (REQUEST_BODY_RETENTION_DAYS), apart
/// from request_log; managed in raw SQL like request_log. No foreign keys (high volume).
model RequestBody {
  requestId         String   @map("request_id")
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)
  organizationId    String   @map("organization_id")
  projectId         String   @map("project_id")
  apiKeyId          String   @map("api_key_id")
  inboundApi        String   @map("inbound_api")
  /// metadata | full
  level             String
  metadata          Json
  /// Redacted JSON text, cut at the size cap; null at the metadata level.
  request           String?
  requestTruncated  Boolean  @default(false) @map("request_truncated")
  response          String?
  responseTruncated Boolean  @default(false) @map("response_truncated")
  streamed          Boolean  @default(false)
  redactions        Int      @default(0)
  /// The conversation as the playground replays it (text only).
  replay            Json?

  @@id([requestId, createdAt])
  @@index([organizationId, createdAt])
  @@map("request_bodies")
}

/// Conditional routing rule (card 32.2): a CEL-subset condition and an action, in priority order.
model RoutingRule {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String
  enabled        Boolean  @default(true)
  /// Lower runs first.
  priority       Int
  /// A team's or a project's own rule; both null means the whole organization.
  teamId         String?  @map("team_id")
  projectId      String?  @map("project_id")
  condition      String
  /// `{ type: 'route', target } | { type: 'reject', message?, status } | { type: 'tag', tags }`
  action         Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, priority])
  @@map("routing_rules")
}

/// Canary / percentage traffic split (card 32.3); every change is a new version.
model TrafficSplit {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String
  enabled        Boolean  @default(true)
  version        Int      @default(1)
  /// The name clients ask for; one split per name and organization.
  match          String
  stable         String
  canary         String
  canaryPercent  Decimal  @map("canary_percent") @db.Decimal(5, 2)
  /// `key`, `session` or `request`
  stickiness     String   @default("key")
  /// `{ enabled, errorRate, minRequests, windowSeconds }` or null for no automatic rollback.
  autoRollback   Json?    @map("auto_rollback")
  /// `active` or `rolled_back` (everything goes to `stable`).
  state          String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     TrafficSplitVersion[]

  @@unique([organizationId, match])
  @@map("traffic_splits")
}

/// History of a traffic split: the configuration of each version and why it was made.
model TrafficSplitVersion {
  id          String   @id
  splitId     String   @map("split_id")
  version     Int
  config      Json
  /// `created`, `updated`, `rollback`, `auto_rollback` or `restore`
  reason      String
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  split TrafficSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)

  @@unique([splitId, version])
  @@map("traffic_split_versions")
}

/// Shadow traffic policy (card 32.4): a sampled copy of matching requests goes to `target`.
model ShadowPolicy {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String
  enabled        Boolean  @default(true)
  /// The name clients ask for, or `*`.
  match          String
  /// One of the organization's own models (or an alias or combo of them).
  target         String
  sampleRate     Decimal  @map("sample_rate") @db.Decimal(5, 4)
  dailyBudgetUsd Decimal  @map("daily_budget_usd") @db.Decimal(18, 8)
  projectId      String?  @map("project_id")
  timeoutMs      Int      @default(60000) @map("timeout_ms")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("shadow_policies")
}

/// One shadow copy (card 32.4): its own cost, never in request_log, the ledger or a wallet.
model ShadowRequest {
  /// `<primary request id>:shadow`
  id               String   @id
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)
  organizationId   String   @map("organization_id")
  policyId         String   @map("policy_id")
  projectId        String   @map("project_id")
  apiKeyId         String   @map("api_key_id")
  primaryRequestId String   @map("primary_request_id")
  modelId          String?  @map("model_id")
  status           String
  httpStatus       Int      @map("http_status")
  errorCode        String?  @map("error_code")
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  costUsd          Decimal  @map("cost_usd") @db.Decimal(18, 8)
  latencyMs        Int      @map("latency_ms")
  primaryModel     String?  @map("primary_model")
  primaryStatus    Int      @map("primary_status")
  primaryLatencyMs Int      @map("primary_latency_ms")
  primaryCostUsd   Decimal  @map("primary_cost_usd") @db.Decimal(18, 8)

  @@index([organizationId, policyId, createdAt])
  @@map("shadow_requests")
}

/// Controls of automatic routing (card 32.8) for an organization or one of its keys.
model AutoRoutingPolicy {
  id              String   @id
  organizationId  String   @map("organization_id")
  /// `organization` or `key`
  scope           String
  /// The organization id or the key id.
  scopeId         String   @map("scope_id")
  /// `low`, `medium` or `high`; null means no ceiling.
  costTier        String?  @map("cost_tier")
  allowedModels   String[] @default([]) @map("allowed_models")
  deniedModels    String[] @default([]) @map("denied_models")
  /// Organization scope only: keys can narrow but never widen the policy.
  locked          Boolean  @default(false)
  /// `auto` or `off`
  reasoningEffort String   @default("auto") @map("reasoning_effort")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, scopeId])
  @@map("auto_routing_policies")
}

/// Routing policies per organization, project or key (cards 32.1, 32.5 and 32.7): provider
/// preferences and their lock, data policy and the routing explanation permission. The JSON is a
/// `RoutingPolicy` from @dirouter/contracts; the gateway combines the three scopes.
model RoutingPolicySetting {
  organizationId String   @map("organization_id")
  /// organization | project | key
  scope          String
  scopeId        String   @map("scope_id")
  policy         Json
  updatedById    String?  @map("updated_by_id")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([organizationId, scope, scopeId])
  @@map("routing_policies")
}
