{
  "name": "@dirouter/shared",
  "version": "1.1.0",
  "private": true,
  "description": "Logger, errors, env, crypto and IDs",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mail": {
      "types": "./dist/mail.d.ts",
      "default": "./dist/mail.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --incremental --tsBuildInfoFile dist/.tsbuildinfo",
    "dev": "tsc -p tsconfig.build.json --incremental --tsBuildInfoFile dist/.tsbuildinfo --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@dirouter/eslint-config": "workspace:*",
    "@dirouter/tsconfig": "workspace:*",
    "@types/smtp-server": "^3.5.13",
    "selfsigned": "^5.5.0",
    "smtp-server": "^3.21.7"
  },
  "dependencies": {
    "@dirouter/contracts": "workspace:*",
    "nodemailer": "^10.6.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  }
}
