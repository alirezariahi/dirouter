# ─── DiRouter environment variables ───
# To auto-generate .env with random secrets:  ./scripts/bootstrap.sh

# Base domain. api.<DOMAIN> → gateway, admin.<DOMAIN> → control-api, app.<DOMAIN> → dashboard.
# In dev, localhost is enough (*.localhost resolves to 127.0.0.1 without DNS).
DOMAIN=localhost
# development | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─── PostgreSQL ───
POSTGRES_USER=dirouter
# Required; a strong random password.
POSTGRES_PASSWORD=
POSTGRES_DB=dirouter
# PostgreSQL image. The semantic cache needs pgvector; build it once with
#   docker build -f deploy/docker/postgres.Dockerfile -t dirouter/postgres:17-pgvector deploy/docker
# and set POSTGRES_IMAGE=dirouter/postgres:17-pgvector (same base, the data volume is reused).
# POSTGRES_IMAGE=postgres:17-alpine
# Published port on localhost (dev only).
POSTGRES_PORT=55432
# Connection address for running locally without Docker (pnpm dev / prisma).
DATABASE_URL=postgresql://dirouter:CHANGE_ME@localhost:55432/dirouter

# ─── Valkey ───
VALKEY_PORT=56379
VALKEY_URL=redis://localhost:56379

# ─── Secrets (never commit) ───
# Encryption keyring for credentials: «1:<base64 32 bytes>», or «1:<old>,2:<new>» for rotation.
MASTER_KEY=
# Pepper for HMAC of virtual keys (min 32 characters). Changing it invalidates all keys.
KEY_PEPPER=
# Dashboard access JWT signing secret (min 32 characters).
JWT_SECRET=
# Internal token for gateway ↔ control-api to fetch the snapshot.
INTERNAL_TOKEN=

# ─── Dashboard and email ───
DASHBOARD_ORIGIN=https://app.localhost
# e.g. smtp://user:pass@smtp.example.com:587; empty means the invite link is only returned by the API.
SMTP_URL=
SMTP_FROM="DiRouter <noreply@localhost>"

# ─── Traefik ───
HTTP_PORT=80
HTTPS_PORT=443
# Let's Encrypt email (production only).
ACME_EMAIL=
# Traefik dashboard users in htpasswd format (bcrypt), comma-separated.
TRAEFIK_DASHBOARD_USERS=
# IP/CIDRs allowed to access the Traefik dashboard, comma-separated.
TRAEFIK_ALLOW_IPS=127.0.0.1/32

# ─── production ───
# Registry and image tags (compose.prod.yaml)
REGISTRY=ghcr.io/alirezariahi/dirouter
TAG=latest
# Gateway replicas with compose.prod.yaml. The HA overlay ignores it (see HA_GATEWAY_REPLICAS).
GATEWAY_REPLICAS=2

# ─── High availability (compose.ha.yaml only; docs/deploy-ha.md) ───
# Password of the PostgreSQL replication role. Required as soon as compose.ha.yaml is used;
# a long random value without spaces or quotes, e.g. `openssl rand -hex 24`.
REPLICATION_PASSWORD=
# Database host for control-api, worker and migrate. Set to postgres-standby after a promotion.
# POSTGRES_HOST=postgres
# Replica counts of the HA overlay.
# HA_GATEWAY_REPLICAS=3
# HA_CONTROL_API_REPLICAS=2
# HA_WORKER_REPLICAS=2
# Most WAL the primary keeps for a standby that is down; beyond it the standby must be re-cloned.
# POSTGRES_MAX_SLOT_WAL_KEEP_SIZE=2GB
# First three octets of the internal network in the HA overlay; Valkey nodes use .11-.13 and the
# sentinels .21-.23. Change it when 10.89.250.0/24 is already used on the host.
# HA_IP_PREFIX=10.89.250
# Optional copy of the WAL archive and base backups to S3/MinIO (compose profile backup-s3).
# BACKUP_S3_ENDPOINT=https://minio.example.com
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_BUCKET=dirouter-backups
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=

# ─── Local SSO test (compose.sso.yaml, development only) ───
# KEYCLOAK_ADMIN_PASSWORD=admin

# ─── Monitoring (optional monitoring profile) ───
# Strong password, separate from the app secrets; required to run the profile. No default value.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=admin
# Grafana and Prometheus ports are published on localhost only.
GRAFANA_PORT=53000
PROMETHEUS_PORT=59090
PROMETHEUS_RETENTION=15d
# GRAFANA_VERSION=12.2.1
# PROMETHEUS_VERSION=v3.7.3

# Retention of raw request logs, in months (aggregate tables are not deleted)
REQUEST_LOG_RETENTION_MONTHS=3

# Optional worker settings; uncomment when tuning is needed.
# USAGE_CONCURRENCY=200
# USAGE_BATCH_SIZE=500
# USAGE_FLUSH_MS=200
# ROLLUP_INTERVAL_MS=30000
# ALERT_EVALUATE_INTERVAL_MS=60000
# HEALTH_SAMPLE_RETENTION_DAYS=30
# DB_MAX_CONNECTIONS=10

# mock-provider only (development/testing; do not enable in production)
# MOCK_DEFAULT=status=503

# dev only: web port of the email UI
# MAILPIT_UI_PORT=58025

# Semantic cache (card 13.2): OpenAI-compatible embeddings endpoint; 1536-dimension model.
# SEMANTIC_CACHE_EMBEDDING_URL=http://gateway:8080/v1/embeddings
# SEMANTIC_CACHE_EMBEDDING_KEY=
# SEMANTIC_CACHE_EMBEDDING_MODEL=text-embedding-3-small
