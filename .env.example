# ─── متغیرهای محیطی DiRouter ───
# برای ساخت خودکار .env با رازهای تصادفی:  ./scripts/bootstrap.sh

# دامنهٔ پایه. api.<DOMAIN> → gateway، admin.<DOMAIN> → control-api، app.<DOMAIN> → داشبورد.
# در dev مقدار localhost کافی است (*.localhost بدون DNS به 127.0.0.1 می‌رسد).
DOMAIN=localhost
# development | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─── PostgreSQL ───
POSTGRES_USER=dirouter
# الزامی؛ رمز قوی تصادفی.
POSTGRES_PASSWORD=
POSTGRES_DB=dirouter
# پورت منتشرشده روی localhost (فقط dev).
POSTGRES_PORT=55432
# آدرس اتصال برای اجرای محلی بدون داکر (pnpm dev / prisma).
DATABASE_URL=postgresql://dirouter:CHANGE_ME@localhost:55432/dirouter

# ─── Valkey ───
VALKEY_PORT=56379
VALKEY_URL=redis://localhost:56379

# ─── رازها (هرگز commit نشوند) ───
# keyring رمزنگاری credentialها: «1:<base64 32 bytes>» یا برای چرخش «1:<old>,2:<new>».
MASTER_KEY=
# pepper برای HMAC کلیدهای مجازی (حداقل ۳۲ کاراکتر). تغییر آن همهٔ کلیدها را باطل می‌کند.
KEY_PEPPER=
# امضای JWT دسترسی داشبورد (حداقل ۳۲ کاراکتر).
JWT_SECRET=
# توکن داخلی gateway ↔ control-api برای دریافت snapshot.
INTERNAL_TOKEN=

# ─── داشبورد و ایمیل ───
DASHBOARD_ORIGIN=https://app.localhost
# مثلاً smtp://user:pass@smtp.example.com:587؛ خالی یعنی لینک دعوت فقط در API برمی‌گردد.
SMTP_URL=
SMTP_FROM="DiRouter <noreply@localhost>"

# ─── Traefik ───
HTTP_PORT=80
HTTPS_PORT=443
# ایمیل Let's Encrypt (فقط production).
ACME_EMAIL=
# کاربران داشبورد Traefik با فرمت htpasswd (bcrypt)، جداشده با ویرگول.
TRAEFIK_DASHBOARD_USERS=
# IP/CIDRهای مجاز به داشبورد Traefik، جداشده با ویرگول.
TRAEFIK_ALLOW_IPS=127.0.0.1/32

# ─── production ───
# رجیستری و تگ ایمیج‌ها (compose.prod.yaml)
REGISTRY=ghcr.io/alirezariahi/dirouter
TAG=latest
GATEWAY_REPLICAS=2

# ─── Monitoring (پروفایل اختیاری monitoring) ───
# رمز قوی و جدا از رازهای اپ؛ برای اجرای پروفایل الزامی است. بدون مقدار پیش‌فرض.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=admin
# پورت‌های Grafana و Prometheus فقط روی localhost منتشر می‌شوند.
GRAFANA_PORT=53000
PROMETHEUS_PORT=59090
PROMETHEUS_RETENTION=15d
# GRAFANA_VERSION=12.2.1
# PROMETHEUS_VERSION=v3.7.3

# نگهداری لاگ خام درخواست‌ها به ماه (جداول تجمیعی حذف نمی‌شوند)
REQUEST_LOG_RETENTION_MONTHS=3

# تنظیمات اختیاری worker؛ هنگام نیاز به tune باز کنید.
# USAGE_CONCURRENCY=200
# USAGE_BATCH_SIZE=500
# USAGE_FLUSH_MS=200
# ROLLUP_INTERVAL_MS=30000
# DB_MAX_CONNECTIONS=10

# فقط mock-provider (توسعه/تست؛ در production فعال نکنید)
# MOCK_DEFAULT=status=503

# فقط dev: پورت وب رابط ایمیل
# MAILPIT_UI_PORT=58025
