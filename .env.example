# ─── DiRouter environment variables ───
# To auto-generate .env with random secrets:  ./scripts/bootstrap.sh

# Base domain. api.<DOMAIN> → gateway, admin.<DOMAIN> → control-api, app.<DOMAIN> → dashboard.
# In dev, localhost is enough (*.localhost resolves to 127.0.0.1 without DNS).
DOMAIN=localhost
# development | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─── PostgreSQL ───
POSTGRES_USER=dirouter
# Required; a strong random password.
POSTGRES_PASSWORD=
POSTGRES_DB=dirouter
# Published port on localhost (dev only).
POSTGRES_PORT=55432
# Connection address for running locally without Docker (pnpm dev / prisma).
DATABASE_URL=postgresql://dirouter:CHANGE_ME@localhost:55432/dirouter

# ─── Valkey ───
VALKEY_PORT=56379
VALKEY_URL=redis://localhost:56379

# ─── Secrets (never commit) ───
# Encryption keyring for credentials: «1:<base64 32 bytes>», or «1:<old>,2:<new>» for rotation.
MASTER_KEY=
# Pepper for HMAC of virtual keys (min 32 characters). Changing it invalidates all keys.
KEY_PEPPER=
# Dashboard access JWT signing secret (min 32 characters).
JWT_SECRET=
# Internal token for gateway ↔ control-api to fetch the snapshot.
INTERNAL_TOKEN=

# ─── Dashboard and email ───
DASHBOARD_ORIGIN=https://app.localhost
# e.g. smtp://user:pass@smtp.example.com:587; empty means the invite link is only returned by the API.
SMTP_URL=
SMTP_FROM="DiRouter <noreply@localhost>"

# ─── Traefik ───
HTTP_PORT=80
HTTPS_PORT=443
# Let's Encrypt email (production only).
ACME_EMAIL=
# Traefik dashboard users in htpasswd format (bcrypt), comma-separated.
TRAEFIK_DASHBOARD_USERS=
# IP/CIDRs allowed to access the Traefik dashboard, comma-separated.
TRAEFIK_ALLOW_IPS=127.0.0.1/32

# ─── production ───
# Registry and image tags (compose.prod.yaml)
REGISTRY=ghcr.io/alirezariahi/dirouter
TAG=latest
GATEWAY_REPLICAS=2

# ─── Monitoring (optional monitoring profile) ───
# Strong password, separate from the app secrets; required to run the profile. No default value.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=admin
# Grafana and Prometheus ports are published on localhost only.
GRAFANA_PORT=53000
PROMETHEUS_PORT=59090
PROMETHEUS_RETENTION=15d
# GRAFANA_VERSION=12.2.1
# PROMETHEUS_VERSION=v3.7.3

# Retention of raw request logs, in months (aggregate tables are not deleted)
REQUEST_LOG_RETENTION_MONTHS=3

# Optional worker settings; uncomment when tuning is needed.
# USAGE_CONCURRENCY=200
# USAGE_BATCH_SIZE=500
# USAGE_FLUSH_MS=200
# ROLLUP_INTERVAL_MS=30000
# DB_MAX_CONNECTIONS=10

# mock-provider only (development/testing; do not enable in production)
# MOCK_DEFAULT=status=503

# dev only: web port of the email UI
# MAILPIT_UI_PORT=58025
