{
  "name": "@dirouter/worker",
  "version": "0.0.0",
  "private": true,
  "description": "پردازش صف، تجمیع و نگهداری",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run src/pipeline.integration.test.ts",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@dirouter/eslint-config": "workspace:*",
    "@dirouter/tsconfig": "workspace:*"
  },
  "dependencies": {
    "@dirouter/contracts": "workspace:*",
    "@dirouter/db": "workspace:*",
    "@dirouter/shared": "workspace:*",
    "bullmq": "^6.7.2",
    "ioredis": "^6.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  }
}
