{
  "name": "@dirouter/worker",
  "license": "Apache-2.0",
  "version": "1.1.0",
  "private": true,
  "description": "Queue processing, aggregation and retention",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage --coverage.thresholds.lines=0 --coverage.thresholds.statements=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --passWithNoTests",
    "test:integration": "vitest run --coverage --no-file-parallelism src/pipeline.integration.test.ts src/budgets.integration.test.ts src/wallets.integration.test.ts src/request-bodies.integration.test.ts src/catalog-sync.integration.test.ts src/balances.integration.test.ts",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@dirouter/eslint-config": "workspace:*",
    "@dirouter/tsconfig": "workspace:*",
    "@types/smtp-server": "^3.5.13",
    "selfsigned": "^5.5.0",
    "smtp-server": "^3.21.7"
  },
  "dependencies": {
    "@dirouter/contracts": "workspace:*",
    "@dirouter/db": "workspace:*",
    "@dirouter/model-catalog": "workspace:*",
    "@dirouter/shared": "workspace:*",
    "bullmq": "^6.7.2",
    "ioredis": "^6.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  }
}
