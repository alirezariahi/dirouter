{
  "name": "@dirouter/control-api",
  "version": "1.1.0",
  "private": true,
  "description": "control plane — API مدیریتی",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/billing/pdf/fonts', 'dist/billing/pdf/fonts', { recursive: true })\"",
    "dev": "tsx watch src/main.ts",
    "seed": "tsx src/seed.ts",
    "openapi:export": "tsx src/export-openapi.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage --coverage.thresholds.lines=0 --coverage.thresholds.statements=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --passWithNoTests",
    "test:integration": "vitest run --coverage --no-file-parallelism --hook-timeout=30000 src/**/*.integration.test.ts",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@dirouter/eslint-config": "workspace:*",
    "@dirouter/mock-provider": "workspace:*",
    "@dirouter/tsconfig": "workspace:*",
    "@types/fontkit": "^2.0.9",
    "@types/pdfkit": "^0.17.7",
    "@types/smtp-server": "^3.5.13",
    "fontkit": "^3.0.0",
    "selfsigned": "^5.5.0",
    "smtp-server": "^3.21.7"
  },
  "dependencies": {
    "@dirouter/contracts": "workspace:*",
    "@dirouter/db": "workspace:*",
    "@dirouter/model-catalog": "workspace:*",
    "@dirouter/providers": "workspace:*",
    "@dirouter/shared": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-fastify": "^12.4.0",
    "@nestjs/swagger": "^12.1.1",
    "@node-rs/argon2": "^2.2.2",
    "@node-saml/node-saml": "^5.2.0",
    "bidi-js": "^1.1.0",
    "bullmq": "^6.7.2",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "js-tiktoken": "^1.0.21",
    "pdfkit": "^0.21.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
