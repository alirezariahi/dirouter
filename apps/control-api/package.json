{
  "name": "@dirouter/control-api",
  "version": "0.0.0",
  "private": true,
  "description": "control plane — API مدیریتی",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "seed": "tsx src/seed.ts",
    "openapi:export": "tsx src/export-openapi.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --no-file-parallelism src/**/*.integration.test.ts",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@dirouter/eslint-config": "workspace:*",
    "@dirouter/tsconfig": "workspace:*"
  },
  "dependencies": {
    "@dirouter/contracts": "workspace:*",
    "@dirouter/db": "workspace:*",
    "@dirouter/model-catalog": "workspace:*",
    "@dirouter/shared": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-fastify": "^12.4.0",
    "@nestjs/swagger": "^12.1.1",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
