{
  "name": "@dirouter/gateway",
  "version": "0.0.0",
  "private": true,
  "description": "data plane — مسیر داغ درخواست‌های LLM",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage src/health-sync.test.ts src/rate-limiter.test.ts src/rate-limiter.unit.test.ts src/budget-guard.test.ts",
    "test": "vitest run --coverage --coverage.thresholds.lines=0 --coverage.thresholds.statements=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@dirouter/eslint-config": "workspace:*",
    "@dirouter/mock-provider": "workspace:*",
    "@dirouter/tsconfig": "workspace:*",
    "openai": "^7.53.0"
  },
  "dependencies": {
    "@dirouter/contracts": "workspace:*",
    "@dirouter/model-catalog": "workspace:*",
    "@dirouter/providers": "workspace:*",
    "@dirouter/routing": "workspace:*",
    "@dirouter/shared": "workspace:*",
    "@dirouter/translator": "workspace:*",
    "bullmq": "^6.7.2",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "js-tiktoken": "^1.0.21",
    "socks": "^2.8.10",
    "prom-client": "^15.1.3",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  }
}
