{
  "name": "@dirouter/portal",
  "version": "1.0.0",
  "private": true,
  "description": "پرتال کاربر نهایی: بازار مدل، ثبت‌نام، شارژ، کلید و صورت‌حساب (کارت ۱۹.۵)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage --coverage.thresholds.lines=0 --coverage.thresholds.statements=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@dirouter/eslint-config": "workspace:*",
    "@dirouter/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
