{
  "name": "@dirouter/mock-provider",
  "version": "0.0.0",
  "private": true,
  "description": "provider ساختگی با تزریق خطا برای تست",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@dirouter/eslint-config": "workspace:*",
    "@dirouter/translator": "workspace:*",
    "@dirouter/tsconfig": "workspace:*"
  },
  "dependencies": {
    "@dirouter/contracts": "workspace:*",
    "@dirouter/shared": "workspace:*",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  }
}
