{
  "name": "@dirouter/mock-provider",
  "license": "Apache-2.0",
  "version": "1.1.0",
  "private": true,
  "description": "Mock provider with fault injection for tests",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@dirouter/eslint-config": "workspace:*",
    "@dirouter/translator": "workspace:*",
    "@dirouter/tsconfig": "workspace:*",
    "@types/ws": "^8.18.2"
  },
  "dependencies": {
    "@dirouter/contracts": "workspace:*",
    "@dirouter/shared": "workspace:*",
    "fastify": "^5.12.8",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./payments": {
      "types": "./dist/payments.d.ts",
      "default": "./dist/payments.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    }
  }
}
